# ==============================================================================
# Sree MK Food Court - Frontend Environment Variables (Cloudflare Pages)
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Public Key (Safe for frontend browsers)
# (from Supabase Dashboard -> Project Settings -> API -> anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key-here

# Optional: Public site URL (set automatically by Cloudflare Pages, or custom domain)
VITE_PUBLIC_URL=https://sree-mk-food-court.pages.dev
